#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Layer numbers. The screens (boards/shields/nice_view_legend) and src/os_layer.c follow them.
 * WIN sits just above Base so the held layers stay on top of it, and NAV_WIN just above NAV.
 */
#define L_BASE 0
#define L_WIN 1
#define L_NUM 2
#define L_SYM 3
#define L_NAV 4
#define L_NAV_WIN 5
#define L_SYSTEM 6

/* Drag out an area to screenshot: Cmd+Shift+4 on a Mac, and Snipping Tool on Windows */
#define SCREENSHOT_MAC LG(LS(N4))
#define SCREENSHOT_WIN LG(LS(S))

&sk { quick-release; };

/* Has to be held this long, so a stray press in a pocket can't turn it off */
&soft_off { hold-time-ms = <2000>; };

/* Balanced so rolling off Enter into the next letter doesn't send Ctrl+letter */
&mt { flavor = "balanced"; };

/*
 * Balanced so a fast roll off a thumb stays a tap, and the idle check so a thumb pressed
 * mid-typing taps straight away instead of waiting to see if it's a hold.
 */
&lt {
    flavor = "balanced";
    quick-tap-ms = <180>;
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <170>;
            tapping-term-ms = <190>;
            global-quick-tap;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 30 31 32 33 34 35 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 30 31 32 33 34 35 25 26 28 27 29 9 8 7 6 5 15>;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        a {
            bindings = <&kp ENTER>;
            key-positions = <7 6>;
            layers = <L_BASE L_WIN>;
            timeout-ms = <30>;
        };

        b {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <L_BASE L_WIN>;
        };

        c {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
            layers = <L_BASE L_WIN>;
            timeout-ms = <30>;
        };

        d {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            layers = <L_BASE L_WIN>;
        };

        e {
            bindings = <&kp MINUS>;
            key-positions = <16 17>;
            layers = <L_BASE L_WIN>;
        };

        f {
            bindings = <&kp EQUAL>;
            key-positions = <17 18>;
            layers = <L_BASE L_WIN>;
        };

        g {
            bindings = <&kp CLCK>;
            key-positions = <11 12>;
            layers = <L_BASE L_WIN>;
        };

        h {
            bindings = <&kp BACKSPACE>;
            key-positions = <9 8>;
            layers = <L_BASE L_WIN>;
        };
    };

    /* Holding both Space thumbs opens SYSTEM, so its keys can't be hit by a fast roll */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <L_NUM L_SYM>;
            then-layer = <L_SYSTEM>;
        };

        /* NAV on Windows: NAV's keys, with Windows shortcuts where they differ */
        nav_win_layer {
            if-layers = <L_WIN L_NAV>;
            then-layer = <L_NAV_WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "Base";
            display-name = "Base";
            bindings = <
  &kp Q  &kp W  &kp E                   &kp R        &kp T                 &kp Y        &kp U      &kp I      &kp O    &kp P
  &kp A  &kp S  &kp D                   &kp F        &kp G                 &kp H        &kp J      &kp K      &kp L    &kp SQT
  &kp Z  &kp X  &kp C                   &kp V        &kp B                 &kp N        &kp M      &kp COMMA  &kp DOT  &kp FSLH
                &lt L_NAV BACKSPACE     &kp LEFT_WIN  &lt L_SYM SPACE      &lt L_NUM SPACE  &mt RCTRL ENTER  &kp RSHFT
            >;
        };

        /*
         * Windows: Ctrl on the left middle thumb in place of Cmd, and holding Enter is Win (for Win+L
         * and the rest) where it was a second Ctrl. src/os_layer.c turns this on while Bluetooth
         * slot 3 (BT_SEL 2, the work computer) is selected and off for the rest.
         */
        win {
            display-name = "WIN";
            bindings = <
  &trans  &trans  &trans  &trans     &trans        &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans     &trans        &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans     &trans        &trans  &trans  &trans  &trans  &trans
                  &trans  &kp LCTRL  &trans        &trans  &mt LGUI ENTER  &trans
            >;
        };

        nav_num {
            display-name = "NUM";
            label = "NUM";
            bindings = <
  &kp N1   &kp N2   &kp N3  &kp N4  &kp N5        &kp N6      &kp N7     &kp N8      &kp N9       &kp N0
  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5        &kp F6      &kp F7     &kp F8      &kp F9       &kp F10
  &kp F11  &kp F12  &none   &none   &kp C_MUTE    &kp C_PREV  &kp C_PP   &kp C_NEXT  &kp C_VOL_DN &kp C_VOL_UP
                    &trans  &trans  &trans        &trans      &trans     &trans
            >;
        };

        /* Bluetooth slots are numbered from 1: V is slot 1 (BT_SEL 0) up to A, slot 5 (BT_SEL 4) */
        sym {
            label = "SYM";
            display-name = "SYM";
            bindings = <
  &kp EXCLAMATION  &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT       &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
  &bt BT_SEL 4     &none         &kp DELETE    &none         &none             &kp LBKT   &kp RBKT       &kp GRAVE     &kp BSLH              &kp SEMI
  &bt BT_SEL 3     &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none             &kp LBRC   &kp RBRC       &kp TILDE     &kp PIPE              &kp COLON
                                 &trans        &trans        &trans            &trans     &trans         &trans
            >;
        };

        layer_3 {
            display-name = "NAV";
            bindings = <
  &kp ESC    &kp TAB             &none     &none      &none    &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp BACKSPACE
  &kp LCTRL  &kp LALT            &kp LGUI  &kp LSHFT  &none    &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &none
  &none      &kp SCREENSHOT_MAC  &none     &none      &none    &none      &none     &none     &none      &none
                                 &trans    &trans     &trans   &trans     &trans    &trans
            >;
        };

        /* NAV while WIN is on, from the conditional layer above */
        nav_win {
            display-name = "NAV_WIN";
            bindings = <
  &trans  &trans              &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
  &trans  &trans              &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
  &trans  &kp SCREENSHOT_WIN  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        /* &bootloader runs on the half the key is on: B for left, N for right */
        system {
            display-name = "SYSTEM";
            bindings = <
  &none  &none  &none   &none   &bt BT_CLR         &out OUT_TOG &none   &none  &soft_off  &none
  &none  &none  &none   &none   &bt BT_CLR_ALL     &none        &none   &none  &none  &none
  &none  &none  &none   &none   &bootloader        &bootloader  &none   &none  &none  &none
                &trans  &trans  &trans             &trans       &trans  &trans
            >;
        };
    };
};
